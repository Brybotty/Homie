# Base de datos PostgreSQL en Azure
DATABASE_URL=postgresql://usuario:contraseña@servidor.postgres.database.azure.com:5432/postgres?sslmode=require

# Puerto y Entorno
PORT=8080
NODE_ENV=production

# URL del Frontend en Vercel
FRONTEND_URL=https://tu-proyecto.vercel.app

# Google OAuth2 (Google Cloud Console)
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=https://tu-backend.azurewebsites.net/api/auth/google/callback

# JWT y Sesión
JWT_SECRET=tu-clave-secreta-jwt-super-segura
SESSION_SECRET=tu-clave-secreta-session

# Emails de administradores autorizados (separados por coma)
ADMIN_EMAILS=ortizgonzalesbryanalexander1@gmail.com
